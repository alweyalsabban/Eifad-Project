{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "app/(authentactionModel)/api/auth/login/route.js",
    "app/(authentactionModel)/forgetPasswoed/page.jsx",
    "app/(authentactionModel)/verify/page.tsx",
    "app/(authentactionModel)/verify/page.tsx",
    "app/(auth)/register/page.tsx",
    "app/(authentactionModel)/api/auth/verify-account/route.js",
    "app/dashBoard/(JobSeekerModel)/main/page.jsx",
    "app/dashBoard/DashBoard.jsx"
  ],
  "exclude": ["node_modules"]
}
